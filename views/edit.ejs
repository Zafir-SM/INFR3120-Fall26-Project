<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card border shadow-sm">
      <div class="card-body p-4 p-md-5">
        <h2 class="fw-bold mb-1">Edit Item Report</h2>
        <p class="text-muted mb-4">Update the details or status for this campus listing.</p>

        <form action="/edit/<%= item.id %>" method="POST">
          <div class="mb-3">
            <label for="itemName" class="form-label fw-semibold">Item Name *</label>
            <input type="text" class="form-control" id="itemName" name="itemName" minlength="2" value="<%= item.itemName %>" required />
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="status" class="form-label fw-semibold">Report Type *</label>
              <select class="form-select" id="status" name="status" required>
                <option value="Lost" <%= item.status === 'Lost' ? 'selected' : '' %>>Lost</option>
                <option value="Found" <%= item.status === 'Found' ? 'selected' : '' %>>Found</option>
              </select>
            </div>

            <div class="col-md-6 mb-3">
              <label for="date" class="form-label fw-semibold">Date *</label>
              <input type="date" class="form-control" id="date" name="date" value="<%= item.date %>" required />
            </div>
          </div>

          <div class="mb-3">
            <label for="location" class="form-label fw-semibold">Campus Location *</label>
            <input type="text" class="form-control" id="location" name="location" minlength="2" value="<%= item.location %>" required />
          </div>

          <div class="mb-4">
            <label for="description" class="form-label fw-semibold">Short Description *</label>
            <textarea class="form-control" id="description" name="description" rows="3" minlength="5" required><%= item.description %></textarea>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
            <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>