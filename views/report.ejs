<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card border shadow-sm">
      <div class="card-body p-4 p-md-5">
        <h2 class="fw-bold mb-1">Report a Lost or Found Item</h2>
        <p class="text-muted mb-4">Fill out the details below to submit a campus lost and found report.</p>

        <form action="/report" method="POST">
          <div class="mb-3">
            <label for="itemName" class="form-label fw-semibold">Item Name *</label>
            <input type="text" class="form-control" id="itemName" name="itemName" minlength="2" placeholder="e.g., Black Hydro Flask, AirPods Pro Case" required />
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="status" class="form-label fw-semibold">Report Type *</label>
              <select class="form-select" id="status" name="status" required>
                <option value="">Select Lost or Found...</option>
                <option value="Lost">Lost</option>
                <option value="Found">Found</option>
              </select>
            </div>

            <div class="col-md-6 mb-3">
              <label for="date" class="form-label fw-semibold">Date *</label>
              <input type="date" class="form-control" id="date" name="date" required />
            </div>
          </div>

          <div class="mb-3">
            <label for="location" class="form-label fw-semibold">Campus Location *</label>
            <input type="text" class="form-control" id="location" name="location" minlength="2" placeholder="e.g., Library 2nd Floor, Science Building Atrium" required />
          </div>

          <div class="mb-4">
            <label for="description" class="form-label fw-semibold">Short Description *</label>
            <textarea class="form-control" id="description" name="description" rows="3" minlength="5" placeholder="Color, brand, stickers, or identifying marks..." required></textarea>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Submit Report</button>
            <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>