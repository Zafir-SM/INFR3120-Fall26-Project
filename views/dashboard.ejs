<%- include('partials/header') %>

<% if (submitted) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <strong>Report submitted!</strong> Your item report has been received for Release 1 preview.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
  <div>
    <h2 class="fw-bold mb-1">Campus Lost &amp; Found Dashboard</h2>
    <p class="text-muted mb-0">Browse active lost and found reports across campus.</p>
  </div>
  <div>
    <a href="/report" class="btn btn-primary">+ Report Item</a>
  </div>
</div>

<div class="card border shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Status</th>
          <th>Item Name</th>
          <th>Location</th>
          <th>Date</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span class="badge rounded-pill px-3 py-2 badge-found">Found</span></td>
          <td class="fw-semibold">Silver MacBook Charger</td>
          <td>Campus Library 1st Floor</td>
          <td>2026-11-18</td>
          <td class="text-muted">USB-C 67W power adapter left near study pod 4.</td>
        </tr>
        <tr>
          <td><span class="badge rounded-pill px-3 py-2 badge-lost">Lost</span></td>
          <td class="fw-semibold">Blue Ontario Tech Lanyard &amp; Keys</td>
          <td>SHA basement</td>
          <td>2026-11-19</td>
          <td class="text-muted">Has two silver keys and a black key fob attached.</td>
        </tr>
        <tr>
          <td><span class="badge rounded-pill px-3 py-2 badge-found">Found</span></td>
          <td class="fw-semibold">Black Hydro Flask (32 oz)</td>
          <td>Science Building Room 2140</td>
          <td>2026-11-19</td>
          <td class="text-muted">Matte black bottle with a white sticker on the lid.</td>
        </tr>
        <tr>
          <td><span class="badge rounded-pill px-3 py-2 badge-lost">Lost</span></td>
          <td class="fw-semibold">Apple AirPods Pro Case</td>
          <td>SIRC First Floor</td>
          <td>2026-11-20</td>
          <td class="text-muted">White charging case inside a navy silicone cover.</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>