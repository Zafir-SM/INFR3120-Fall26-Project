
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet"
        href="/stylesheets/dashboard.css">
</head>
<body>

  <nav class="navbar">
    <a href="/" class="logo">FindIt</a>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/report">Report an Item</a>
    </div>
  </nav>

  <main class="container">

    <header class="page-header">
      <h1>Lost & Found Dashboard</h1>
      <p>Browse lost and found items around campus.</p>
    </header>

    <div class="filters">
      <a href="/dashboard?filter=all"
         class="<%= activeFilter === 'all' ? 'active' : '' %>">
        All Items
      </a>

      <a href="/dashboard?filter=lost"
         class="<%= activeFilter === 'lost' ? 'active' : '' %>">
        Lost
      </a>

      <a href="/dashboard?filter=found"
         class="<%= activeFilter === 'found' ? 'active' : '' %>">
        Found
      </a>
    </div>

    <section class="items-grid">

      <% if (items.length === 0) { %>
        <div class="empty-state">
          <h2>No items found</h2>
          <p>There are no reports in this category.</p>
        </div>
      <% } else { %>

        <% items.forEach(function(item) { %>
          <article class="item-card">
            <span class="item-type <%= item.type.toLowerCase() %>">
              <%= item.type %>
            </span>

            <h2><%= item.name %></h2>

            <p><strong>Location:</strong>
              <%= item.location %>
            </p>

            <p><strong>Date:</strong>
              <%= item.date %>
            </p>

            <p class="description">
              <%= item.description %>
            </p>

            <p><strong>Status:</strong>
              <%= item.status %>
            </p>
          </article>
        <% }); %>

      <% } %>

    </section>
  </main>

</body>
</html>

